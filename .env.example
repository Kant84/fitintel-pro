# ============================================================
# FitIntel Pro — корневой .env (ОБРАЗЕЦ). Скопируйте в .env
# и ЗАПОЛНИТЕ/ЗАМЕНИТЕ все CHANGE_ME. Без .env prod-compose не стартует.
# ============================================================

# ---------- PostgreSQL (ОБЯЗАТЕЛЬНО) ----------
POSTGRES_DB=fitnexus_ai
POSTGRES_USER=fitnexus_user
POSTGRES_PASSWORD=CHANGE_ME_long_random_32+
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ---------- API / безопасность ----------
SECRET_KEY=CHANGE_ME_long_random_64+
APP_ENV=dev
APP_DEBUG=true
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:8000
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- Redis / Celery ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ---------- BLAS-лимиты (КРИТИЧНО: без них dlib/отчёты висят 10-60 сек) ----------
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# ---------- Касса АТОЛ ----------
# Адрес/логин/пароль ДТО-10 хранятся в БД (desktop → «Платежи → Настройки кассы»)
FISCAL_DTO_URL=
FISCAL_DTO_LOGIN=
FISCAL_DTO_PASSWORD=

# ---------- SKUD ITC (Basic Auth для /skud/*) ----------
ITC_BASIC_USER=itc
ITC_BASIC_PASSWORD=CHANGE_ME

# ---------- ЮKassa (онлайн-оплата) ----------
# Предпочтительно настраивать в десктопе: Настройки → Сервисы (таблица server_settings).
# Здесь — значения по умолчанию/фолбэк. ACCOUNT_ID = идентификатор магазина.
YOOKASSA_ACCOUNT_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_TEST_MODE=true

# ---------- Generic payment webhooks ----------
# POST /api/v1/payments/webhook/{payment_system}
# Секрет отдельный для каждого провайдера, небезопасного default нет.
# Generic: X-Payment-Signature = hex HMAC-SHA256 от raw body.
# CloudPayments: Content-HMAC = Base64 HMAC-SHA256 от raw body.
PAYMENT_WEBHOOK_SECRET_TBANK=
PAYMENT_WEBHOOK_SECRET_SBERBANK=
PAYMENT_WEBHOOK_SECRET_CLOUDPAYMENTS=

# ---------- Банк-эквайринг (онлайн-оплата без ЮKassa) ----------
# JSON в server_settings (ключ BANK_CONFIG), пример:
# {"active":"sber","sber":{"mode":"json","merchant_id":"...","token":"..."}}
# {"active":"tinkoff","tinkoff":{"terminal_key":"...","password":"...","notification_url":"https://домен/api/v1/bank/webhook"}}
# Webhook банка: https://<домен>/api/v1/bank/webhook

# ---------- MAX-бот ----------
# Токен/секрет webhook предпочтительно в десктопе: Настройки → Сервисы
# (или POST /api/v1/max-bot/settings). Webhook MAX: https://<домен>/api/v1/max-bot/webhook
MAX_BOT_WEBHOOK_SECRET=

# ---------- СБП (mock до договора с банком) ----------
SBP_MOCK=true

# ---------- Мессенджеры ----------
MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
DIGEST_TIME=09:00

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FitIntel Pro <no-reply@club.example.ru>
SMTP_SSL=true

# ---------- SMS (smsc.ru) ----------
SMS_USER=
SMS_PASSWORD=

# ---------- Web Push (VAPID) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:admin@club.example.ru

# ---------- 1С (CommerceML / HTTP API V3) ----------
ONEC_API_URL=http://server-1c:8080/base/hs/api3
ONEC_LOGIN=
ONEC_PASSWORD=
ONEC_MOCK=true

# ---------- A&A / вебхуки ----------
AA_WEBHOOK_TOKEN=

# ---------- Мониторинг ----------
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME   # по умолчанию admin/admin — сменить!

# ---------- Экспорт / QR ----------
EXPORT_LINK_SECRET=CHANGE_ME
QR_SECRET_KEY=CHANGE_ME
QR_TTL_MINUTES=5
# Вход по QR из MAX: бот выдаёт одноразовый QR для турникета (false — отключить)
MAX_QR_ENTRY_ENABLED=true