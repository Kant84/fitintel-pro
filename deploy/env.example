# ============================================================
# FitIntel Pro — deploy/.env (ОБРАЗЕЦ). Скопируйте в deploy/.env
# и ЗАПОЛНИТЕ/ЗАМЕНИТЕ все CHANGE_ME. Без .env prod-compose не стартует.
# ============================================================

# ---------- PostgreSQL (ОБЯЗАТЕЛЬНО) ----------
POSTGRES_DB=fitnexus_ai
POSTGRES_USER=fitnexus_user
POSTGRES_PASSWORD=CHANGE_ME_long_random_32+
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- API / безопасность ----------
SECRET_KEY=CHANGE_ME_long_random_64+
APP_ENV=production
APP_DEBUG=false
DOCS_ENABLED=false
CORS_ORIGINS=https://club.example.ru
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- Redis / Celery ----------
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- BLAS-лимиты (КРИТИЧНО: без них dlib/отчёты висят 10-60 сек) ----------
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# ---------- Касса АТОЛ ----------
# Адрес/логин/пароль ДТО-10 хранятся в БД (desktop → «Платежи → Настройки кассы»)
FISCAL_DTO_URL=
FISCAL_DTO_LOGIN=
FISCAL_DTO_PASSWORD=

# ---------- SKUD ITC (Basic Auth для /skud/*) ----------
ITC_BASIC_USER=itc
ITC_BASIC_PASSWORD=CHANGE_ME

# ---------- YooKassa ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_TEST_MODE=false

# ---------- СБП (mock до договора с банком) ----------
SBP_MOCK=true

# ---------- Мессенджеры ----------
MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
DIGEST_TIME=09:00

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FitIntel Pro <no-reply@club.example.ru>
SMTP_SSL=true

# ---------- SMS (smsc.ru) ----------
SMS_USER=
SMS_PASSWORD=

# ---------- Web Push (VAPID) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:admin@club.example.ru

# ---------- 1С (CommerceML / HTTP API V3) ----------
ONEC_API_URL=http://server-1c:8080/base/hs/api3
ONEC_LOGIN=
ONEC_PASSWORD=
ONEC_MOCK=false

# ---------- A&A / вебхуки ----------
AA_WEBHOOK_TOKEN=

# ---------- Мониторинг ----------
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME   # по умолчанию admin/admin — сменить!

# ---------- Экспорт / QR ----------
EXPORT_LINK_SECRET=CHANGE_ME
QR_SECRET_KEY=CHANGE_ME
QR_TTL_MINUTES=5