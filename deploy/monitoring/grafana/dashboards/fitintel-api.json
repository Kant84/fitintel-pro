{"title":"FitIntel API","uid":"fitintel-api","schemaVersion":39,"refresh":"10s",
"time":{"from":"now-6h","to":"now"},"timezone":"browser",
"panels":[
{"id":1,"type":"stat","title":"Запросов/сек","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":6,"w":6,"x":0,"y":0},"targets":[{"expr":"sum(rate(fitnexus_api_requests_total[1m]))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"options":{}},
{"id":2,"type":"stat","title":"Ошибок 5xx, %","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":6,"w":6,"x":6,"y":0},"targets":[{"expr":"100 * sum(rate(fitnexus_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(fitnexus_api_requests_total[5m])), 1)","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},"options":{}},
{"id":3,"type":"stat","title":"p95 латентность, с","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":6,"w":6,"x":12,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(fitnexus_api_request_duration_seconds_bucket[5m])) by (le))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"options":{}},
{"id":4,"type":"stat","title":"API up","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":6,"w":6,"x":18,"y":0},"targets":[{"expr":"up{job=\"fitintel-api\"}","refId":"A"}],"fieldConfig":{"defaults":{},"overrides":[]},"options":{}},
{"id":5,"type":"timeseries","title":"Запросы по статусам","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":8,"w":12,"x":0,"y":6},"targets":[{"expr":"sum by (status) (rate(fitnexus_api_requests_total[1m]))","refId":"A","legendFormat":"{{status}}"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi"}}},
{"id":6,"type":"timeseries","title":"Топ-5 путей по p95","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":8,"w":12,"x":12,"y":6},"targets":[{"expr":"topk(5, histogram_quantile(0.95, sum(rate(fitnexus_api_request_duration_seconds_bucket[5m])) by (le, path)))","refId":"A","legendFormat":"{{path}}"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi"}}},
{"id":7,"type":"logs","title":"Логи API (Loki)","datasource":{"type":"loki","uid":"loki"},"gridPos":{"h":10,"w":24,"x":0,"y":14},"targets":[{"expr":"{container=\"deploy-api-1\"}","refId":"A","datasource":{"type":"loki","uid":"loki"}}],"options":{"showTime":true,"wrapLogMessage":true,"sortOrder":"Descending","enableLogDetails":true}}
