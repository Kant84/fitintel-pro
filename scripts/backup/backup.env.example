# FitIntel Pro — настройки автобэкапа (скопируйте в backup.env)
COMPOSE_DIR=$HOME/fitintel-pro/deploy
COMPOSE_FILE=docker-compose.test.yml
LOCAL_DIR=$HOME/fitintel-backups
DB_SERVICE=db
DB_USER=fitnexus_user
DB_NAME=fitnexus_ai
RETENTION_DAYS=14
HDD_ENABLE=0
HDD_MOUNT=/mnt/hdd
CLOUD_ENABLE=0
RCLONE_REMOTE=yandex
